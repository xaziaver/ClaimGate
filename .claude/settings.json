{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "gauntlet",
            "args": [
              "guard"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "gauntlet",
            "args": [
              "check",
              "--gates",
              "static,size,complexity",
              "--changed"
            ],
            "timeout": 60,
            "statusMessage": "Gauntlet: fast gates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gauntlet",
            "args": [
                "stop-check",
                "--max-attempts",
                "1"
            ],
            "timeout": 1800,
            "statusMessage": "Gauntlet: full run"
          }
        ]
      }
    ]
  }
}
